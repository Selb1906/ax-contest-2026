# 데이터안심구역 실 LP 소스 설정 — 스카우팅 방문 후 컬럼명 확정하여 복사·수정
source:
  kind: dsz_lp
  path: "/path/to/real_lp/"      # 안심구역 내 디렉터리 (CSV/parquet 모두)
  # 원본 컬럼명 → 표준 컬럼명 매핑 (스카우팅에서 확인)
  column_map:
    customer_id:   "고객번호"
    ts:            "검침일시"
    contract_type: "계약종별"
    p_active_kwh:  "유효전력량"
    p_reactive_kwh: "무효전력량"
    max_demand_kw: "최대수요전력"
  # 원본에 계약종별 컬럼이 없고 파일이 종별로 분리돼 있다면 이 필드로 덮어쓰기
  contract_type_default: null
